#!/bin/sh
# tasks <engagement> <Tnnn>
# Prints the ingestion checklist for one transcript, each step marked from the files on disk, and writes it
# to sessions/Tnnn/TASKS.md. Derived, never edited: the files are the truth.
. "$(dirname "$0")/lib.sh"
[ $# -eq 2 ] || die "usage: tasks <engagement> <Tnnn>"
eng=$1; tid=$2; d=$(eng_dir "$eng"); sdir="$d/sessions/$tid"
sheet="$sdir/$tid.session.md"; dossier="$sdir/$tid.dossier.md"; log="$sdir/$tid.session-log.md"; tf=$(item_path "$eng" "$tid")
st=$("$INGESTER_DIR/bin/stage" "$eng" "$tid" status 2>/dev/null || echo unknown)
done_() { printf -- '- [x] %s\n' "$1"; }; todo() { printf -- '- [ ] %s\n' "$1"; }; now() { printf -- '- [ ] **%s**  (current step)\n' "$1"; }
mark() { if [ "$2" = done ]; then done_ "$1"; elif [ "$2" = now ]; then now "$1"; else todo "$1"; fi; }
registered=todo; s0=todo; roles=todo; sheet_ok=todo; stk=todo; s1=todo; s2=todo; s3=todo
[ -f "$tf" ] && registered=done
[ -f "$sdir/$tid.utterances.tsv" ] && [ -f "$sheet" ] && s0=done
[ -f "$sheet" ] && grep -q '^## Notes for the reviewer' "$sheet" && [ "$(awk '/^## Notes for the reviewer/ { on=1; next } on && NF' "$sheet" | wc -l)" -gt 0 ] && roles=done
[ -f "$sheet" ] && sheet_signed "$sheet" > /dev/null 2>&1 && sheet_ok=done
[ -f "$log" ] && grep -q '^- Stakeholders written on:' "$log" && stk=done
[ -f "$dossier" ] && s1=done
[ -f "$dossier" ] && dossier_signed "$dossier" > /dev/null 2>&1 && s2=done
[ -f "$log" ] && grep -q '^- S3 written on:' "$log" && s3=done
case $st in needs-register) registered=now ;; needs-s0) s0=now ;; awaiting-session-sheet) [ $roles = done ] && sheet_ok=now || roles=now ;; needs-s1) [ $stk = done ] && s1=now || stk=now ;; awaiting-dossier) s2=now ;; needs-s3) s3=now ;; esac
ref="$d/evaluation/$tid-reference.md"; refstate=todo; [ -f "$ref" ] && [ -n "$(header_field "$ref" 'Marked by')" ] && refstate=done
runs=$(ls "$d/evaluation" 2>/dev/null | grep -c "^$tid-run-"); score=todo; [ "$runs" -gt 0 ] && score=done
phases_named=todo; [ "$(phases "$eng" | grep -c .)" -gt 0 ] && [ "$(phases "$eng" | grep -c -e '^Later phase$' -e '^Day one$')" -eq 0 ] && phases_named=done
{
  printf '# Tasks: %s in %s\n\nGenerated by `ingester/bin/tasks` on %s from the files on disk. Status word: `%s`. Regenerated by every `stage` call; do not edit.\n\n' "$tid" "$eng" "$(today)" "$st"
  printf '## Before the first run\n\n'
  mark "Name the phases in \`engagement.md\` under Phases (placeholders are Day one and Later phase)" $phases_named
  mark "Hand-mark the reference \`evaluation/$tid-reference.md\` from \`ingester/templates/reference.md\` (optional before the first run; the reviewed dossier can serve instead)" $refstate
  printf '\n## Pipeline\n\n'
  mark "Register the transcript: \`transcripts/$tid.md\` with file name and SHA-256" $registered
  mark "S0 Prepare: utterance table and session sheet generated (\`sessions/$tid/$tid.utterances.tsv\`, \`$tid.session.md\`)" $s0
  mark "S0 proposals: role, segment, department, standing and Decides proposed for every speaker with a citation; Mentioned and Forum rows; session date and domain" $roles
  mark "Human: review and sign the session sheet (every Verdict filled, Approver and Approved on)" $sheet_ok
  mark "S1 gate: stakeholder files written to \`stakeholders/\` from the signed sheet" $stk
  mark "S1 Read: the skill reads the whole transcript and writes \`$tid.exchanges.md\`, \`$tid.episodes.md\` and \`$tid.dossier.md\`, self-checked" $s1
  mark "Human: give a verdict on every dossier item; the skill then marks it Completed by and writes" $s2
  mark "S3 Write: item files, claims, topics, transcript file, session log, index tables; transcript moved to \`processed/\`" $s3
  printf '\n## After the run\n\n'
  mark "Score the drafted dossier against the reference (\`stage $eng $tid score ...\`); $runs run report(s) so far" $score
  todo "Tag failure modes in the run report and fold them into \`ingester/extraction-rules.md\` as the next rules version"
  printf '\nNext command: '
  case $st in
    needs-register) printf '`ingester/bin/register-transcript %s <vtt>`\n' "$eng" ;;
    needs-s0) printf '`/ingest-transcript %s %s` (runs S0)\n' "$tid" "$eng" ;;
    awaiting-session-sheet) printf 'sign `sessions/%s/%s.session.md`, then `/ingest-transcript %s %s`\n' "$tid" "$tid" "$tid" "$eng" ;;
    needs-s1) printf '`/ingest-transcript %s %s` (runs S1)\n' "$tid" "$eng" ;;
    awaiting-dossier) printf 'sign `sessions/%s/%s.dossier.md`, then `/ingest-transcript %s %s`\n' "$tid" "$tid" "$tid" "$eng" ;;
    needs-s3) printf '`/ingest-transcript %s %s` (runs S3)\n' "$tid" "$eng" ;;
    done) printf 'none; %s is written. Score it, or register the next transcript.\n' "$tid" ;;
    *) printf 'resolve: %s\n' "$st" ;;
  esac
} > "$sdir/TASKS.md" 2>/dev/null || true
cat "$sdir/TASKS.md"
