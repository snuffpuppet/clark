#!/bin/sh
# dossier2episodes <dossier> [<out>]
# Writes Tnnn.episodes.md from the dossier, so the two cannot disagree. The episodes file repeats the span,
# topic, subject and outcome already carried by the dossier's episode headings, plus the item numbers each
# episode yielded; generating it removes the copy (S1 review notes 6.2). Default out is Tnnn.episodes.md
# beside the dossier. A "- Confirmed by:" line in an existing file is preserved (runbook staged-review).
set -e
. "$(dirname "$0")/lib.sh"
[ $# -ge 1 ] && [ -f "$1" ] || die "usage: dossier2episodes <dossier> [<out>]"
dossier=$1
tid=$(header_field "$dossier" Transcript); [ -n "$tid" ] || die "no - Transcript: line in $dossier"
out=${2:-$(dirname "$dossier")/$tid.episodes.md}

confirmed=""; ver="0.1"
if [ -f "$out" ]; then
  confirmed=$(grep -m1 '^- Confirmed by:' "$out" || true)
  v=$(doc_version "$out"); [ -n "$v" ] && ver="${v%%.*}.$(( ${v#*.} + 1 ))"
fi

items=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX")
"$INGESTER_DIR/bin/dossier2tsv" "$dossier" > "$items"
{
  printf '# Episodes: %s\n\nVersion %s, %s.\n\n- Transcript: %s\n- Session date: %s\n- Meeting subject: %s\n- Ingester version: %s\n- Rules version: %s\n' \
    "$tid" "$ver" "$(today)" "$tid" "$(header_field "$dossier" 'Session date')" "$(header_field "$dossier" 'Meeting subject')" \
    "$(header_field "$dossier" 'Ingester version')" "$(header_field "$dossier" 'Rules version')"
  [ -n "$confirmed" ] && printf '%s\n' "$confirmed"
  printf '\nGenerated by `ingester/bin/dossier2episodes` from %s, so the two cannot drift. One block per episode. Topic names the TOP item that created or extended the topic; the topic ids themselves are reserved at S3. Outputs lists every dossier item the episode owns. Do not edit; edit the dossier and regenerate.\n' "$(basename "$dossier")"
  "$INGESTER_DIR/bin/dossier2tsv" -e "$dossier" | while IFS="$TAB" read -r id title span topic subject outcome bulk flow; do
    outputs=$(awk -F'\t' -v e="$id" '$6 == e { printf "%s%s", (n++ ? ", " : ""), $1 } END { if (!n) printf "none" }' "$items")
    printf '\n## %s %s\n\n- Title: %s\n- Span: %s\n- Topic: %s\n- Subject: %s\n- Outcome: %s\n- Outputs: %s\n' \
      "$id" "$title" "$title" "$span" "$topic" "$subject" "$outcome" "$outputs"
  done
} > "$out"
rm -f "$items"
printf 'dossier2episodes: %s episode(s) written to %s\n' "$("$INGESTER_DIR/bin/dossier2tsv" -e "$dossier" | grep -c .)" "$out"
