#!/bin/sh
# score-flow <engagement> <Tnnn> <reference> [<processes-file>]
# Scores a drafted processes file (F13) against a flow reference in the same shape (runbook evaluate, design
# Q4), and writes evaluation/Tnnn-flow-run-nn.md. Also `score <engagement> <Tnnn> --flow <reference> [file]`.
# Steps are matched by cited fragments: each reference step goes to the draft step sharing most fragments with
# it. Reported per reference process and in total:
#   recall      reference steps matched by some draft step
#   order       of the pairs of matched reference steps in one process, the share the draft puts in the same
#               order (draft order is file order, which F13 makes flow order)
#   compound    draft steps matched by two or more reference steps (R20)
#   misfiled    draft steps whose matched reference step is in another process than most of their section (R21)
#   as step     draft steps whose best match is a reference process fact (R22)
set -e
. "$(dirname "$0")/lib.sh"
[ $# -ge 3 ] || die "usage: score-flow <engagement> <Tnnn> <reference> [processes-file]"
eng=$1; tid=$2; ref=$3; d=$(eng_dir "$eng"); dos=${4:-$d/sessions/$tid/$tid.processes.md}
[ -f "$ref" ] || die "no reference at $ref"; [ -f "$dos" ] || die "no processes file at $dos"
mkdir -p "$d/evaluation"
n=$(ls "$d/evaluation" | grep -o "^$tid-flow-run-[0-9][0-9]" | sed 's/.*-//' | sort -n | tail -1); run=$(printf '%02d' $(( ${n:-0} + 1 )))
out="$d/evaluation/$tid-flow-run-$run.md"
R=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX"); D=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX")
# Rows: kind, section, item, fragment set. The section of an item is the ## Tnnn-Pnn heading above it.
rows() { tsec=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX"); ttsv=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX"); awk '/^## / { sec = $2 } /^### Item / { print "@" sec }' "$1" > "$tsec"
  "$INGESTER_DIR/bin/dossier2tsv" "$1" > "$ttsv"
  awk -F'\t' -v secf="$tsec" '
    function frags(cites,   s, n, i, m, j, tok, set, u, lo, hi, f, r) { set = ""; n = split(cites, c, "\002")
      for (i = 1; i <= n; i++) { s = c[i]; if (!match(s, /T[0-9][0-9][0-9]\/[0-9][0-9:, -]*/)) continue; tok = substr(s, RSTART + 5, RLENGTH - 5)
        m = split(tok, parts, /, */); for (j = 1; j <= m; j++) { r = parts[j]; gsub(/ /, "", r); if (r == "") continue; u = r; sub(/:.*/, "", u); f = r; sub(/^[^:]*:/, "", f)
          lo = f; hi = f; if (index(f, "-")) { lo = f; sub(/-.*/, "", lo); hi = f; sub(/^[^-]*-/, "", hi) }
          for (k = lo + 0; k <= hi + 0; k++) set = set " " u ":" k } }
      return set " " }
    BEGIN { while ((getline l < secf) > 0) if (l ~ /^@/) sec[++ns] = substr(l, 2) }
    { if ($5 != "new") next; if ($2 != "PRC.step" && $2 != "PRC.fact") next; printf "%s\t%s\t%s\t%s\n", $2, sec[NR], $1, frags($9) }' "$ttsv"
  rm -f "$tsec" "$ttsv"; }
rows "$ref" > "$R"; rows "$dos" > "$D"
awk -F'\t' -v run="$run" -v today="$(today)" -v tid="$tid" -v refname="$(printf '%s' "$ref" | sed "s#^$d/##")" -v dosname="$(printf '%s' "$dos" | sed "s#^$d/##")" '
  function ov(a, b,   n, i, t, c) { c = 0; n = split(a, t, " "); for (i = 1; i <= n; i++) if (t[i] != "" && index(b, " " t[i] " ")) c++; return c }
  FILENAME == ARGV[1] { nr++; rk[nr] = $1; rs[nr] = $2; ri[nr] = $3; rf[nr] = $4; next }
  { nd++; dk[nd] = $1; ds[nd] = $2; di[nd] = $3; df[nd] = $4 }
  END {
    # Each reference claim to its best draft step.
    for (r = 1; r <= nr; r++) { best = 0; bo = 0
      for (i = 1; i <= nd; i++) if (dk[i] == "PRC.step") { o = ov(rf[r], df[i]); if (o > bo) { bo = o; best = i } }
      m[r] = best; if (best && rk[r] == "PRC.step") { hits[best]++; secvote[ds[best], rs[r]]++ } }
    # Each draft section to the reference process most of its matched steps belong to.
    for (k in secvote) { split(k, p, SUBSEP); if (secvote[k] > bestv[p[1]]) { bestv[p[1]] = secvote[k]; home[p[1]] = p[2] } }
    for (r = 1; r <= nr; r++) { s = rs[r]; if (rk[r] != "PRC.step") continue; tot[s]++; if (m[r]) got[s]++; secs[s] = 1 }
    for (r = 1; r <= nr; r++) if (rk[r] == "PRC.step" && m[r]) for (q = r + 1; q <= nr; q++) if (rk[q] == "PRC.step" && m[q] && rs[q] == rs[r] && m[q] != m[r]) { pairs[rs[r]]++; if (m[q] > m[r]) agree[rs[r]]++ }
    for (i = 1; i <= nd; i++) if (dk[i] == "PRC.step") { steps++; if (hits[i] >= 2) { comp++; tag[++nt] = "Item " di[i] " | compound | matches " hits[i] " reference steps | step-collapsed" } }
    for (r = 1; r <= nr; r++) if (rk[r] == "PRC.step" && m[r] && home[ds[m[r]]] != rs[r]) { mis[m[r]] = 1 }
    for (i in mis) { misn++; tag[++nt] = "Item " di[i] " | misfiled | its reference step is in another process | step-misfiled" }
    for (r = 1; r <= nr; r++) if (rk[r] == "PRC.fact" && m[r]) { bo2 = 0; for (q = 1; q <= nr; q++) if (rk[q] == "PRC.step" && m[q] == m[r]) bo2 = 1; if (!bo2) { asstep++; tag[++nt] = "Item " di[m[r]] " | fact as step | matches reference fact " ri[r] " | statement-as-step" } }
    for (r = 1; r <= nr; r++) if (rk[r] == "PRC.step" && !m[r]) tag[++nt] = "Reference item " ri[r] " | missed | no draft step on its fragments | step-collapsed or flow-gap-unraised"
    printf "# Flow run %s: %s\n\n- Reference: %s\n- Processes file: %s\n- Scored on: %s\n\n", run, tid, refname, dosname, today
    printf "| Reference process | Steps | Matched | Recall | Pairs | In order | Order agreement |\n|---|---|---|---|---|---|---|\n"
    for (s in secs) { T += tot[s]; G += got[s]; P += pairs[s]; A += agree[s]
      printf "| %s | %d | %d | %s | %d | %d | %s |\n", s, tot[s], got[s] + 0, (tot[s] ? sprintf("%.0f%%", 100 * got[s] / tot[s]) : "n/a"), pairs[s] + 0, agree[s] + 0, (pairs[s] ? sprintf("%.0f%%", 100 * agree[s] / pairs[s]) : "n/a") }
    printf "| All | %d | %d | %s | %d | %d | %s |\n\n", T, G, (T ? sprintf("%.0f%%", 100 * G / T) : "n/a"), P, A, (P ? sprintf("%.0f%%", 100 * A / P) : "n/a")
    printf "- Draft steps: %d\n- Compound steps: %d\n- Misfiled steps: %d\n- Facts drafted as steps: %d\n\n## Tags\n\n| Item | Finding | Detail | Failure mode |\n|---|---|---|---|\n", steps, comp + 0, misn + 0, asstep + 0
    for (t = 1; t <= nt; t++) print "| " tag[t] " |" }' "$R" "$D" > "$out"
rm -f "$R" "$D"
eng_log "$eng" "$tid flow scored: run $run against $(basename "$ref")."
printf 'wrote %s\n' "$out"; awk '/^\| Reference process/,/^$/' "$out"; grep '^- ' "$out" | tail -4
