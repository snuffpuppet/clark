#!/bin/sh
# stage <engagement> <Tnnn> <status|tasks|S0|S1|S3|S4|check|score <reference> [dossier]|summary [<from> <to>]|log <stage> "<outcome>"|backfill <KIND> [check]>
# The driver. status prints one word for where the transcript is. Each stage refuses to start when its
# predecessor is not signed. Every branch except status writes a run log under logs/.
set -e
. "$(dirname "$0")/lib.sh"
[ $# -ge 3 ] || die "usage: stage <engagement> <Tnnn> <status|S0|S1|S3|S4|check|score|summary|log|backfill>"
eng=$1; tid=$2; cmd=$3; shift 3; d=$(eng_dir "$eng"); sdir="$d/sessions/$tid"
sheet="$sdir/$tid.session.md"; dossier="$sdir/$tid.dossier.md"
[ -f "$d/engagement.md" ] || die "no engagement at $d"

status() {
  [ -f "$(item_path "$eng" "$tid")" ] || { echo needs-register; return; }
  vtt=$(vtt_path "$eng" "$tid" 2>&1) || { echo "blocked: $vtt"; return; }
  case "$vtt" in */processed/*)
    # After S3: the processes stage (runbook S4).
    log="$sdir/$tid.session-log.md"; procs="$sdir/$tid.processes.md"
    [ -f "$log" ] && grep -q '^- S4 written on:' "$log" && { echo done; return; }
    [ -f "$procs" ] || { echo needs-s4; return; }
    processes_signed "$procs" > /dev/null || { echo awaiting-processes; return; }
    echo needs-s4-write; return ;; esac
  [ -f "$sdir/$tid.utterances.tsv" ] && [ -f "$sheet" ] || { echo needs-s0; return; }
  sheet_signed "$sheet" > /dev/null || { echo awaiting-session-sheet; return; }
  [ -f "$dossier" ] || { echo needs-s1; return; }
  dossier_signed "$dossier" > /dev/null || { echo awaiting-dossier; return; }
  echo needs-s3; }

case $cmd in
  status) status ;;
  S0) s=$(status); [ "$s" = needs-s0 ] || die "S0 refused: state is $s"
      out=$("$INGESTER_DIR/bin/s0-prepare" "$eng" "$tid"); printf '%s\n' "$out"
      log_run "$eng" "$tid" S0 "prepared" "transcripts.md stakeholders.md $(transcript_parts "$eng" "$tid" | sed 's/^[^ ]* //' | awk '{ printf "%s%s", (NR > 1 ? " " : ""), $0 }')" "sessions/$tid/$tid.utterances.tsv sessions/$tid/$tid.session.md" ;;
  S1) s=$(status); if [ "$s" = needs-s1 ]; then "$INGESTER_DIR/bin/s1-stakeholders" "$eng" "$tid"; echo "S1 is performed by the skill; gate open"; log_run "$eng" "$tid" S1 "gate open" "$sheet" "" > /dev/null
      else r=$(sheet_signed "$sheet" 2>&1 || true); die "S1 refused: state is $s${r:+ ($r)}"; fi ;;
  S3) s=$(status); [ "$s" = needs-s3 ] || { r=""; [ -f "$dossier" ] && r=$(dossier_signed "$dossier" || true); die "S3 refused: state is $s${r:+ ($r)}"; }
      "$INGESTER_DIR/bin/s3-write" "$eng" "$tid" ;;
  S4) s=$(status); case $s in needs-s4-write) "$INGESTER_DIR/bin/s4-write" "$eng" "$tid" ;;
      needs-s4) echo "S4 is read by the skill (runbook S4); no processes file yet" ;;
      *) r=""; [ -f "$sdir/$tid.processes.md" ] && r=$(processes_signed "$sdir/$tid.processes.md" || true); die "S4 refused: state is $s${r:+ ($r)}" ;; esac ;;
  check) rc=0; procs="$sdir/$tid.processes.md"
      if [ -f "$procs" ] && [ "$(status)" != done ] && [ "$(status)" != needs-s3 ] && [ "$(status)" != awaiting-dossier ]; then dossier=$procs; fi
      [ -f "$dossier" ] && { "$INGESTER_DIR/bin/check-citations" "$eng" "$tid" "$dossier" || rc=1; }
      if [ -f "$dossier" ]; then "$INGESTER_DIR/bin/check-integrity" "$eng" --proposed "$dossier" || rc=1; else "$INGESTER_DIR/bin/check-integrity" "$eng" || rc=1; fi
      log_run "$eng" "$tid" check "$([ $rc -eq 0 ] && echo passed || echo failed)" "$dossier" "" > /dev/null; exit $rc ;;
  score) [ $# -ge 1 ] || die "usage: stage <eng> <Tnnn> score <reference> [dossier]"
      "$INGESTER_DIR/bin/score" "$eng" "$tid" "$@"; log_run "$eng" "$tid" score "scored against $1" "$1 ${2:-$dossier}" "evaluation/" > /dev/null ;;
  summary) "$INGESTER_DIR/bin/summary" "$eng" "$tid" "$@" ;;
  log) [ $# -ge 2 ] || die "usage: stage <eng> <Tnnn> log <stage> \"<outcome>\""; log_run "$eng" "$tid" "$1" "$2" "${3:-}" "${4:-}" ;;
  tasks) "$INGESTER_DIR/bin/tasks" "$eng" "$tid" ;;
  backfill) [ $# -ge 1 ] || die "usage: stage <eng> <Tnnn> backfill <KIND> [check]"
      bk=$1; bf="$sdir/$tid.backfill-$bk.md"; log="$sdir/$tid.session-log.md"; s=$(status)
      [ "$s" = done ] || die "backfill refused: state is $s; a backfill runs on a transcript whose S4 is written"
      ! grep -q "^- Backfill $bk written on:" "$log" || die "backfill refused: the $bk backfill of $tid is already written"
      [ -f "$bf" ] || { echo "the $bk backfill is read by the skill (runbook backfill); no backfill file yet"; exit 0; }
      if [ "${2:-}" = check ]; then rc=0; "$INGESTER_DIR/bin/check-citations" "$eng" "$tid" "$bf" || rc=1; "$INGESTER_DIR/bin/check-integrity" "$eng" --proposed "$bf" || rc=1
        log_run "$eng" "$tid" "backfill-$bk-check" "$([ $rc -eq 0 ] && echo passed || echo failed)" "$bf" "" > /dev/null; exit $rc; fi
      r=$(dossier_signed "$bf") || die "backfill refused: $r"
      "$INGESTER_DIR/bin/s3-write" "$eng" "$tid" --backfill "$bk" ;;
  *) die "unknown command $cmd" ;;
esac
[ "$cmd" = tasks ] || [ "$cmd" = status ] || "$INGESTER_DIR/bin/tasks" "$eng" "$tid" > /dev/null 2>&1 || true
