#!/bin/sh
# stage <engagement> <Tnnn> <status|tasks|S0|S1|S3|check|score <reference> [dossier]|log <stage> "<outcome>">
# The driver. status prints one word for where the transcript is. Each stage refuses to start when its
# predecessor is not signed. Every branch except status writes a run log under logs/.
set -e
. "$(dirname "$0")/lib.sh"
[ $# -ge 3 ] || die "usage: stage <engagement> <Tnnn> <status|S0|S1|S3|check|score|log>"
eng=$1; tid=$2; cmd=$3; shift 3; d=$(eng_dir "$eng"); sdir="$d/sessions/$tid"
sheet="$sdir/$tid.session.md"; dossier="$sdir/$tid.dossier.md"
[ -f "$d/engagement.md" ] || die "no engagement at $d"

status() {
  [ -f "$(item_path "$eng" "$tid")" ] || { echo needs-register; return; }
  vtt=$(vtt_path "$eng" "$tid" 2>&1) || { echo "blocked: $vtt"; return; }
  case "$vtt" in */processed/*) echo done; return ;; esac
  [ -f "$sdir/$tid.utterances.tsv" ] && [ -f "$sheet" ] || { echo needs-s0; return; }
  sheet_signed "$sheet" > /dev/null || { echo awaiting-session-sheet; return; }
  [ -f "$dossier" ] || { echo needs-s1; return; }
  dossier_signed "$dossier" > /dev/null || { echo awaiting-dossier; return; }
  echo needs-s3; }

case $cmd in
  status) status ;;
  S0) s=$(status); [ "$s" = needs-s0 ] || die "S0 refused: state is $s"
      out=$("$INGESTER_DIR/bin/s0-prepare" "$eng" "$tid"); printf '%s\n' "$out"
      log_run "$eng" "$tid" S0 "prepared" "transcripts.md stakeholders.md $(basename "$(vtt_path "$eng" "$tid")")" "sessions/$tid/$tid.utterances.tsv sessions/$tid/$tid.session.md" ;;
  S1) s=$(status); if [ "$s" = needs-s1 ]; then "$INGESTER_DIR/bin/s1-stakeholders" "$eng" "$tid"; echo "S1 is performed by the skill; gate open"; log_run "$eng" "$tid" S1 "gate open" "$sheet" "" > /dev/null
      else r=$(sheet_signed "$sheet" 2>&1 || true); die "S1 refused: state is $s${r:+ ($r)}"; fi ;;
  S3) s=$(status); [ "$s" = needs-s3 ] || { r=""; [ -f "$dossier" ] && r=$(dossier_signed "$dossier" || true); die "S3 refused: state is $s${r:+ ($r)}"; }
      "$INGESTER_DIR/bin/s3-write" "$eng" "$tid" ;;
  check) rc=0; [ -f "$dossier" ] && { "$INGESTER_DIR/bin/check-citations" "$eng" "$tid" "$dossier" || rc=1; }
      if [ -f "$dossier" ]; then "$INGESTER_DIR/bin/check-integrity" "$eng" --proposed "$dossier" || rc=1; else "$INGESTER_DIR/bin/check-integrity" "$eng" || rc=1; fi
      log_run "$eng" "$tid" check "$([ $rc -eq 0 ] && echo passed || echo failed)" "$dossier" "" > /dev/null; exit $rc ;;
  score) [ $# -ge 1 ] || die "usage: stage <eng> <Tnnn> score <reference> [dossier]"
      "$INGESTER_DIR/bin/score" "$eng" "$tid" "$@"; log_run "$eng" "$tid" score "scored against $1" "$1 ${2:-$dossier}" "evaluation/" > /dev/null ;;
  log) [ $# -ge 2 ] || die "usage: stage <eng> <Tnnn> log <stage> \"<outcome>\""; log_run "$eng" "$tid" "$1" "$2" "${3:-}" "${4:-}" ;;
  tasks) "$INGESTER_DIR/bin/tasks" "$eng" "$tid" ;;
  *) die "unknown command $cmd" ;;
esac
[ "$cmd" = tasks ] || [ "$cmd" = status ] || "$INGESTER_DIR/bin/tasks" "$eng" "$tid" > /dev/null 2>&1 || true
