#!/bin/sh
# check-integrity <engagement> [--proposed <dossier>]
# Runs the integrity rules of solution-register-model.md 2.18 section 9 over the engagement's item files
# (requirements/, decisions/, limitations/, risks/, open-items/, processes/, systems/, stakeholders/).
# With --proposed, the dossier's accepted items and the session sheet's accepted new stakeholders are
# merged in as virtual rows first, so links to items created in the same session resolve.
# Prints FAIL and WARN lines, then OK when nothing failed. Exit 1 on FAIL. I10 and I17 are retired; I5 is Phase valid.
. "$(dirname "$0")/lib.sh"
[ $# -ge 1 ] || die "usage: check-integrity <engagement> [--proposed <dossier>]"
eng=$1; d=$(eng_dir "$eng"); dossier=""; [ "${2:-}" = "--proposed" ] && dossier=$3
[ -f "$d/engagement.md" ] || die "no engagement at $d"
facts=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX")

# Stream: TYPE <tab> ID <tab> KEY <tab> VALUE. Frontmatter keys become model field names; body sections too.
for type in REQ DEC LIM RSK OI; do dir="$d/$(item_dir "$type")"
  for f in "$dir"/$type-*.md; do [ -f "$f" ] || continue
    awk -v type="$type" '
      function name(k) { gsub(/-/, " ", k); k = toupper(substr(k, 1, 1)) substr(k, 2); if (k == "Moscow") k = "MoSCoW"; return k }
      function flush() { if (sec != "") { v = body; gsub(/^ +| +$/, "", v); printf "%s\t%s\t%s\t%s\n", type, id, sec, v } sec = ""; body = "" }
      NR == 1 && $0 == "---" { infm = 1; next }
      infm && $0 == "---" { infm = 0; if (listk != "") { printf "%s\t%s\t%s\t%s\n", type, id, name(listk), list }; listk = ""; next }
      infm && /^  - / { v = $0; sub(/^  - /, "", v); list = list (list == "" ? "" : "; ") v; next }
      infm { if (listk != "") { printf "%s\t%s\t%s\t%s\n", type, id, name(listk), list; listk = ""; list = "" }
             k = $0; sub(/:.*/, "", k); v = $0; sub(/^[^:]*:/, "", v); gsub(/^ +| +$/, "", v)
             if (k == "id") { id = v; printf "%s\t%s\tID\t%s\n", type, id, id; next }
             if ($0 ~ /:$/) { listk = k; list = "" } else printf "%s\t%s\t%s\t%s\n", type, id, name(k), v; next }
      /^## / { flush(); sec = $0; sub(/^## /, "", sec); next }
      sec != "" { body = body " " $0 }
      END { flush() }' "$f"
  done
done >> "$facts"
for f in "$d"/systems/SYS-*.md "$d"/processes/PRC-*.md; do [ -f "$f" ] || continue
  id=$(fm "$f" id); printf 'ELEM\t%s\tID\t%s\n' "$id" "$id"
  for s in $(claim_sections "$f"); do printf 'CLAIM\t%s.%s\tStatus\t%s\n' "$id" "$s" "$(claim_field "$f" "$s" status)"; done
done >> "$facts"
phases "$eng" | awk '{ printf "PHASE\t%s\tvalue\t%s\n", $0, $0 }' >> "$facts"
for f in "$d"/stakeholders/STK-*.md; do [ -f "$f" ] || continue
  id=$(fm "$f" id); printf 'STK\t%s\tName\t%s\nSTK\t%s\tVariants\t%s\nSTK\t%s\tRole\t%s\nSTK\t%s\tSegment\t%s\n' "$id" "$(fm "$f" name)" "$id" "$(fm_list "$f" variants | paste -sd, -)" "$id" "$(fm "$f" role)" "$id" "$(fm "$f" segment)"
done >> "$facts"

if [ -n "$dossier" ]; then
  [ -f "$dossier" ] || die "no such dossier $dossier"
  tid=$(header_field "$dossier" Transcript); sheet="$(dirname "$dossier")/$tid.session.md"
  accepted_items "$dossier" | awk -F'\t' '
    { kind = $2; target = $5; item = $1; fields = $8; type = kind; sub(/\..*/, "", type)
      if (kind == "SYS.fact" || kind == "PRC.step") { id = (target == "new") ? "CLAIM-item" item : target; st = ""
        n = split(fields, kv, "\001"); for (i = 1; i <= n; i++) { k = kv[i]; sub(/=.*/, "", k); v = kv[i]; sub(/^[^=]*=/, "", v); if (k == "Status") st = v }
        printf "CLAIM\t%s\tStatus\t%s\n", id, st; printf "ITEMMAP\titem %s\tid\t%s\n", item, id; next }
      if (kind == "SYS" || kind == "PRC") { id = (target == "new") ? kind "-item" item : target; if (target == "new") printf "ELEM\t%s\tID\t%s\n", id, id; printf "ITEMMAP\titem %s\tid\t%s\n", item, id; next }
      if (type != "REQ" && type != "DEC" && type != "LIM" && type != "RSK" && type != "OI") next
      id = (target == "new") ? type "-item" item : target
      printf "ITEMMAP\titem %s\tid\t%s\n", item, id
      # A new item declares its id; a mutation overlays its changed fields on the row read from disk (F4 Target).
      if (target == "new") printf "%s\t%s\tID\t%s\n", type, id, id; else printf "%s\t%s\tMUTATES\titem %s\n", type, id, item
      printf "%s\t%s\tProposed\tyes\n", type, id
      n = split(fields, kv, "\001"); for (i = 1; i <= n; i++) { k = kv[i]; sub(/=.*/, "", k); v = kv[i]; sub(/^[^=]*=/, "", v); if (k != "Gist") printf "%s\t%s\t%s\t%s\n", type, id, k, v }
      if ($9 != "") { c = $9; gsub(/\002/, "; ", c); printf "%s\t%s\t%s\t%s\n", type, id, (type == "OI" ? "Raised by" : "Source"), c } }' >> "$facts"
  if [ -f "$sheet" ]; then
    awk '/^## New stakeholders/ { on=1 } /^## Notes/ { on=0 } on && /^\| new \|/' "$sheet" | awk -F'|' '{ v=$(NF-1); gsub(/ /, "", v); if (v == "Accept" || v == "Edit") { n=$3; r=$5; s=$6; gsub(/^ +| +$/, "", n); gsub(/^ +| +$/, "", r); gsub(/^ +| +$/, "", s); printf "STK\tSTK-new%d\tName\t%s\nSTK\tSTK-new%d\tVariants\t\nSTK\tSTK-new%d\tRole\t%s\nSTK\tSTK-new%d\tSegment\t%s\n", NR, n, NR, NR, r, NR, s } }' >> "$facts"
  fi
fi

awk -F'\t' -v today="$(today)" '
  function lc(s) { return tolower(s) }
  function fail(rule, id, why) { printf "FAIL %s %s: %s\n", rule, id, why; fails++ }
  function warn(rule, id, why) { printf "WARN %s %s: %s\n", rule, id, why }
  function has(id, k) { return ((id SUBSEP k) in F) && F[id, k] != "" }
  function days(dt,   p, m, i) { split(dt, p, " "); if (p[3] == "") return -1
    split("January February March April May June July August September October November December", mn, " ")
    for (i = 1; i <= 12; i++) if (mn[i] == p[2]) m = i; if (!m) return -1
    y = p[3] + 0; if (m <= 2) { y--; m += 12 }; return 365*y + int(y/4) - int(y/100) + int(y/400) + int(30.6*(m+1)) + p[1] }
  function older14(dt) { dd = days(dt); return dd > 0 && days(today) - dd > 14 }
  function person_ok(nm,   n, i, s, m) { n = lc(nm); gsub(/^ +| +$/, "", n)
    if (n == "" || n == "joint" || n ~ /^vendor/) return 1
    for (s in STK) { if (lc(STKname[s]) == n) return 1
      m = split(STKvar[s], vv, /, */); for (i = 1; i <= m; i++) { x = lc(vv[i]); gsub(/^ +| +$/, "", x); if (x != "" && x == n) return 1 } }
    return 0 }
  function mentioned(nm,   s, n) { n = lc(nm); for (s in STK) if (lc(STKname[s]) == n && STKrole[s] == "Mentioned") return 1; return 0 }
  function resolve(tok) { return ((("item " tok) in MAP) ? MAP["item " tok] : tok) }
  function linked_oi_has_owner(id,   n, i, t, o) { n = split(F[id, "Links"], parts, /;/)
    for (i = 1; i <= n; i++) { t = parts[i]; if (match(t, /OI-[0-9a-z]+/)) { o = substr(t, RSTART, RLENGTH); if (has(o, "Owner")) return 1 }
      if (match(t, /item [0-9]+/)) { o = resolve(substr(t, RSTART + 5, RLENGTH - 5)); if (has(o, "Owner")) return 1 } }
    return 0 }
  { type = $1; id = $2; key = $3; val = $4
    if (type == "ITEMMAP") { MAP[id] = val; next }
    if (type == "PHASE") { PHASE[val] = 1; nphase++; next }
    if (type == "STK") { STK[id] = 1; if (key == "Name") STKname[id] = val; if (key == "Variants") STKvar[id] = val; if (key == "Role") STKrole[id] = val; if (key == "Segment") STKseg[id] = val; next }
    if (type == "ELEM") { if (id in ELEM) dupe[id] = 1; ELEM[id] = 1; next }
    if (type == "CLAIM") { CLAIM[id] = val; next }
    if (key == "MUTATES") { MUT[id] = val; if (!(id in T)) { T[id] = type; order[++cnt] = id; seen[id]++; MISSING[id] = 1 } OLD[id] = F[id, "Status"]; next }
    if (!(id in T)) { T[id] = type; order[++cnt] = id; seen[id]++ } else if (T[id] != type || key == "ID") seen[id]++
    F[id, key] = val }
  END {
    V["REQ", "Draft"] = V["REQ", "Agreed"] = V["REQ", "Designed"] = V["REQ", "Delivered"] = V["REQ", "Verified"] = V["REQ", "Deferred"] = V["REQ", "Withdrawn"] = 1
    V["DEC", "Proposed"] = V["DEC", "Accepted"] = V["DEC", "Superseded"] = V["DEC", "Rejected"] = 1
    V["LIM", "Identified"] = V["LIM", "Under assessment"] = V["LIM", "Accepted"] = V["LIM", "Resolved"] = 1
    V["RSK", "Identified"] = V["RSK", "Mitigating"] = V["RSK", "Realised"] = V["RSK", "Retired"] = 1
    V["OI", "Open"] = V["OI", "In progress"] = V["OI", "Blocked"] = V["OI", "Closed"] = 1
    TERM["REQ Verified"] = TERM["REQ Deferred"] = TERM["REQ Withdrawn"] = TERM["DEC Superseded"] = TERM["DEC Rejected"] = 1
    TERM["LIM Accepted"] = TERM["LIM Resolved"] = TERM["RSK Realised"] = TERM["RSK Retired"] = TERM["OI Closed"] = 1
    for (s in STK) { if (STKseg[s] != "" && STKseg[s] != "Residential" && STKseg[s] != "BE&G" && STKseg[s] != "Wholesale") fail("I19", s, "segment \"" STKseg[s] "\" is not Residential, BE&G, Wholesale or blank") }
    for (e in dupe) fail("I1", e, "element id appears more than once")
    for (i = 1; i <= cnt; i++) { id = order[i]; t = T[id]; st = F[id, "Status"]; term = ((t " " st) in TERM)
      if (seen[id] > 1 || (id in ELEM) || (id in STK)) fail("I1", id, "id appears more than once")
      if (id in MISSING) fail("I6", id, MUT[id] " targets " id ", which does not exist")
      if ((id in MUT) && t == "DEC" && OLD[id] == "Accepted" && st != "Accepted" && st != "Superseded") fail("I11", id, MUT[id] " changes an Accepted decision to " st "; an Accepted decision can only be Superseded")
      if ((id in MUT) && t == "OI" && OLD[id] == "Closed") fail("I9", id, MUT[id] " changes a Closed open item; raise a new one instead")
      if (!((t SUBSEP st) in V)) fail("I2", id, "status \"" st "\" is not a " t " status")
      if (t == "REQ") { if (!has(id, "MoSCoW")) fail("I2", id, "no MoSCoW"); if (!has(id, "Raised on")) fail("I2", id, "no Raised on") }
      if (t == "LIM") { if (!has(id, "Identified on")) fail("I2", id, "no Identified on"); if (st != "Identified" && !has(id, "Impact")) fail("I2", id, "no Impact past Identified")
        if (st == "Accepted" && (split(F[id, "Options"], oo, /[0-9]+\. /) < 3 || !has(id, "Chosen option"))) fail("I2", id, "Accepted needs two Options and a Chosen option") }
      if (t == "RSK") { if (!has(id, "Identified on")) fail("I2", id, "no Identified on"); if (st == "Mitigating" && (!has(id, "Trigger") || !has(id, "Mitigation"))) fail("I2", id, "Mitigating needs Trigger and Mitigation") }
      if ((t == "REQ" || t == "OI") && !term && !has(id, "Owner")) fail("I3", id, "no Owner")
      if ((t == "DEC" || t == "LIM" || t == "RSK") && !has(id, "Raised by")) fail("I3", id, "no Raised by")
      if (((t == "DEC" && st == "Proposed") || (t == "REQ" && st == "Draft") || (t == "LIM" && st == "Under assessment")) && !linked_oi_has_owner(id)) fail("I3", id, t " in " st " needs an open item in Links with an Owner")
      if (t == "OI" && st != "Closed" && !has(id, "Next action")) fail("I4", id, "open item needs Next action")
      if (t == "OI" && st != "Closed" && !has(id, "Due")) warn("I4", id, "open item has no Due")
      if (t == "RSK" && !term && !has(id, "Due")) warn("I4", id, "risk has no Due as its review date")
      if (t == "REQ" && nphase && has(id, "Phase") && !(F[id, "Phase"] in PHASE)) fail("I5", id, "phase \"" F[id, "Phase"] "\" is not in the Phases list in engagement.md")
      links = F[id, "Links"]; n = split(links, lk, /;/)
      for (j = 1; j <= n; j++) { l = lk[j]
        while (match(l, /item [0-9]+/)) { r = resolve(substr(l, RSTART + 5, RLENGTH - 5)); l = substr(l, 1, RSTART - 1) r substr(l, RSTART + RLENGTH) }
        if (match(l, /(SYS|PRC)-[0-9a-z]+\.[fs][0-9]+/) || match(l, /CLAIM-item[0-9]+/)) { c = substr(l, RSTART, RLENGTH)
          if (!(c in CLAIM)) fail("I18", id, "link target " c " is not in the current-state record")
          else if (l ~ /(replaces|preserves)/ && (CLAIM[c] == "Retired" || CLAIM[c] == "Withdrawn")) fail("I18", id, c " is " CLAIM[c] " and cannot be replaced or preserved") }
        else if (match(l, /(REQ|DEC|LIM|RSK|OI)-[0-9a-z]+/)) { c = substr(l, RSTART, RLENGTH); if (!(c in T)) fail("I6", id, "link target " c " does not exist") } }
      if (t == "LIM") { dr = F[id, "Disposition record"]
        if (st == "Accepted" && !(dr in T && T[dr] == "DEC" && F[dr, "Status"] == "Accepted")) fail("I7", id, "Accepted needs a Disposition record that is a DEC in Accepted")
        if ((st == "Identified" || st == "Under assessment") && dr != "") fail("I7", id, "has a Disposition record before disposition")
        if (match(links, /previously dispositioned by DEC-[0-9]+/)) { p = substr(links, RSTART + 28, RLENGTH - 28); if (!(p in T) || F[p, "Status"] != "Superseded") fail("I7", id, "previously dispositioned by must name a DEC in Superseded") } }
      if (t == "DEC" && st == "Superseded") { if (!match(links, /superseded by DEC-[0-9a-z]+/)) fail("I8", id, "Superseded needs a superseded by link"); else { s2 = substr(links, RSTART + 14, RLENGTH - 14); if (!(s2 in T) || (F[s2, "Status"] != "Accepted" && F[s2, "Status"] != "Proposed")) fail("I8", id, "superseded by must point at a DEC in Accepted or Proposed") } }
      if (t == "OI") { if (st == "Closed" && (!has(id, "Resolution") || !has(id, "Closed on"))) fail("I9", id, "Closed needs Resolution and Closed on")
        if (st == "Blocked" && !has(id, "Blocked by")) fail("I9", id, "Blocked needs Blocked by"); if (st != "Blocked" && has(id, "Blocked by")) fail("I9", id, "Blocked by set while not Blocked") }
      if (t == "DEC") { if ((st == "Accepted" || st == "Rejected") && (!has(id, "Approved by") || !has(id, "Decided on") || !has(id, "Consulted"))) fail("I11", id, st " needs Approved by, Decided on and Consulted"); if (!has(id, "Raised by")) fail("I11", id, "no Raised by") }
      if ((t == "REQ" || t == "DEC" || t == "LIM") && F[id, "Implemented by"] !~ /^(Vendor|Internal|Both)$/) fail("I12", id, "Implemented by must be Vendor, Internal or Both")
      if (t == "RSK" && st == "Realised" && links !~ /realised as (OI-[0-9a-z]+|item [0-9]+)/) fail("I13", id, "Realised needs a realised as OI link")
      if (t != "OI" && !has(id, "Source")) fail("I14", id, "no Source")
      if (t == "OI" && (!has(id, "Raised on") || !has(id, "Raised by"))) fail("I14", id, "open item needs Raised on and Raised by")
      if (t == "DEC" && st == "Proposed" && older14(F[id, "Updated"])) warn("I15", id, "Proposed for more than 14 days")
      if (t == "REQ" && st == "Draft" && older14(F[id, "Raised on"])) warn("I15", id, "Draft for more than 14 days")
      if (t == "DEC" && links !~ /addresses (REQ-[0-9a-z]+|item [0-9]+)/ && lc(F[id, "Rationale"]) !~ /accept/) warn("I16", id, "no addresses REQ link and no accepts wording in Rationale")
      split("Owner Raised by Approved by", pf, " ")
      for (j = 1; j <= 3; j++) { v = F[id, pf[j]]; if (v == "" || v ~ /T[0-9][0-9][0-9]\// || v ~ /[0-9] [A-Z][a-z]+ [0-9][0-9][0-9][0-9]/) continue
        if (!person_ok(v)) fail("I19", id, pf[j] " \"" v "\" is not a known stakeholder")
        if (pf[j] == "Owner" && mentioned(v)) fail("I19", id, "Owner \"" v "\" has Role Mentioned") }
      if (has(id, "Consulted")) { m = split(F[id, "Consulted"], cc, /, */); for (j = 1; j <= m; j++) if (!person_ok(cc[j])) fail("I19", id, "Consulted \"" cc[j] "\" is not a known stakeholder") }
    }
    if (fails) { printf "%d integrity failure(s)\n", fails; exit 1 } print "OK" }
' "$facts" && rc=0 || rc=$?
rm -f "$facts"; exit $rc
