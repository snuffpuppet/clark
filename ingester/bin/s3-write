#!/bin/sh
# s3-write <engagement> <Tnnn>
# The write stage. Checks every gate, then writes one file per accepted dossier item (or edits the file the
# item targets), appends claims as sections to their process or system file, extends topics, applies
# stakeholder edits, completes the transcript file, writes the session log, regenerates the index tables
# and moves the transcript to processed/. Refuses on any failed gate; restores everything on failure.
set -e
. "$(dirname "$0")/lib.sh"
[ $# -eq 2 ] || die "usage: s3-write <engagement> <Tnnn>"
eng=$1; tid=$2; d=$(eng_dir "$eng"); sdir="$d/sessions/$tid"
sheet="$sdir/$tid.session.md"; dossier="$sdir/$tid.dossier.md"; log="$sdir/$tid.session-log.md"
TODAY=$(today)

# Gates.
vtt=$(vtt_path "$eng" "$tid")
case "$vtt" in */processed/*) die "$tid is already processed; nothing written" ;; esac
[ -f "$sheet" ] || die "no session sheet"; [ -f "$dossier" ] || die "no dossier"
r=$(sheet_signed "$sheet") || die "gate: $r"
r=$(dossier_signed "$dossier") || die "gate: $r"
[ ! -f "$log" ] || ! grep -q "^- S3 written on:" "$log" || die "session log says $tid has been written"
US=$(printf '\003'); items=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX"); accepted_items "$dossier" | tr "\t" "\003" > "$items"
# Elements before the claims that hang off them: a SYS.fact cannot be written until its SYS file exists.
awk -F"$US" '{ if ($2 == "SYS" || $2 == "PRC") a[++na] = $0; else b[++nb] = $0 } END { for (i = 1; i <= na; i++) print a[i]; for (i = 1; i <= nb; i++) print b[i] }' "$items" > "$items.ord" && mv "$items.ord" "$items"
acc=$(mktemp "${TMPDIR:-/tmp}/ing.XXXXXXXX"); cut -d "$US" -f9 "$items" | tr '\002' '\n' | grep . | sed 's/^/  - /' > "$acc" || true
r=$("$INGESTER_DIR/bin/check-citations" "$eng" "$tid" "$acc") || die "gate: citation check failed on accepted items: $r"
r=$("$INGESTER_DIR/bin/check-integrity" "$eng" --proposed "$dossier") || die "gate: integrity failed on the proposed set: $r"
rm -f "$acc"

# Snapshot the item folders so a failure part-way leaves the engagement as it was.
snap=$(mktemp -d "${TMPDIR:-/tmp}/ing.XXXXXXXX"); ok=0
FOLDERS="requirements decisions limitations risks open-items processes systems stakeholders topics index"
for f in $FOLDERS; do [ -d "$d/$f" ] && cp -R "$d/$f" "$snap/$f"; done
mkdir -p "$snap/transcripts"; cp "$d"/transcripts/T[0-9]*.md "$snap/transcripts/" 2>/dev/null || true
cp "$d/engagement.md" "$snap/engagement.md"; [ -f "$log" ] && cp "$log" "$snap/session-log"
rollback() { [ "$ok" = 1 ] && { rm -rf "$snap"; return; }
  for f in $FOLDERS; do rm -rf "$d/$f"; [ -d "$snap/$f" ] && cp -R "$snap/$f" "$d/$f"; done
  cp "$snap"/transcripts/T[0-9]*.md "$d/transcripts/" 2>/dev/null || true; cp "$snap/engagement.md" "$d/engagement.md"
  if [ -f "$snap/session-log" ]; then cp "$snap/session-log" "$log"; else rm -f "$log"; fi
  rm -rf "$snap"; echo "S3 failed; the engagement was restored to its state before the write" >&2; }
trap rollback EXIT

session_date=$(header_field "$sheet" 'Session date' | sed 's/ (.*//'); domain=$(header_field "$sheet" Domain | sed 's/ (.*//')
sheet_appr=$(header_field "$sheet" Approver); sheet_on=$(header_field "$sheet" 'Approved on')
dos_appr=$(header_field "$dossier" 'Completed by'); [ -n "$dos_appr" ] || dos_appr=$(header_field "$dossier" Approver)
dos_on=$(header_field "$dossier" 'Completed on'); [ -n "$dos_on" ] || dos_on=$(header_field "$dossier" 'Approved on')
"$INGESTER_DIR/bin/s1-stakeholders" "$eng" "$tid" > /dev/null
sed -i '' "s/^- Dossier completed by: .*/- Dossier completed by: $dos_appr/" "$log"
logrow() { printf '| %s | %s | %s | %s | %s |\n' "$1" "$2" "$3" "$4" "$TODAY" >> "$log"; }

# Helpers on one dossier2tsv row.
fld() { printf '%s' "$1" | tr '\001' '\n' | awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }'; }
cite_lines() { printf '%s' "$1" | tr '\002' '\n' | grep . | sed 's/^/- /'; }
upper_snake() { printf '%s' "$1" | tr 'a-z ' 'A-Z_' | sed 's/MOSCOW/MOSCOW/'; }
kebab() { printf '%s' "$1" | tr 'A-Z ' 'a-z-'; }
resolve_items() { s=$1; for pair in $IDMAP; do it=${pair%%=*}; id=${pair#*=}; s=$(printf '%s' "$s" | sed "s/item $it\$/$id/g; s/item $it\([^0-9]\)/$id\1/g"); done; printf '%s' "$s"; }
RES=$(mktemp -d "${TMPDIR:-/tmp}/ing.XXXXXXXX")
reserve_id() { p=$1; n=$(next_id "$eng" "$p" | sed "s/^$p-//"); [ -f "$RES/$p" ] && r=$(( $(cat "$RES/$p") + 1 )) && [ "$r" -gt "$n" ] && n=$r; printf '%s' "$n" > "$RES/$p"; printf '%s-%04d\n' "$p" "$n"; }

# Pass one: ids for new items so links between them resolve.
IDMAP=""
while IFS="$US" read -r item kind grade verdict target episode bulk fields cites; do
  type=${kind%%.*}
  case $kind in REQ|DEC|LIM|RSK|OI|SYS|PRC|TOP) [ "$target" = new ] && id=$(reserve_id "$type") || id=$target; IDMAP="$IDMAP $item=$id" ;; esac
done < "$items"

# Pass two: write.
while IFS="$US" read -r item kind grade verdict target episode bulk fields cites; do
  type=${kind%%.*}; id=""; for pair in $IDMAP; do [ "${pair%%=*}" = "$item" ] && id=${pair#*=}; done
  case $kind in
    REQ|DEC|LIM|RSK|OI)
      path=$(item_path "$eng" "$id")
      if [ "$target" = new ]; then
        vals; set_val ID "$id"; set_val TID "$tid"; set_val EPISODE "$episode"; set_val DATE "$TODAY"
        printf '%s' "$fields" | tr '\001' '\n' | while IFS= read -r kv; do k=${kv%%=*}; v=$(resolve_items "${kv#*=}"); [ "$k" = Gist ] && k=Notes; [ "$k" = Links ] && continue; set_val "$(upper_snake "$k")" "$v"; done
        set_list LINKS "$(resolve_items "$(fld "$fields" Links)" | tr ';' '\n' | sed 's/^ *//')"
        if [ "$type" = OI ]; then set_val RAISED_BY "$(cite_lines "$cites")"; else set_val SOURCE "$(cite_lines "$cites")"; fi
        render "$INGESTER_DIR/templates/items/$type.md" "$path"; vals_done
        logrow "$id" created "$(item_dir "$type")/$id.md" "$(fld "$fields" Title)"
      else
        # A mutation (F4 Target): every field in the block is set as it should read afterwards, the block's
        # citations join Source (Raised by on an open item), and one F10 History line records each old and new value.
        [ -f "$path" ] || die "item $item targets $id, which does not exist"
        changes=$(printf '%s' "$fields" | tr '\001' '\n' | while IFS= read -r kv; do k=${kv%%=*}; v=$(resolve_items "${kv#*=}")
          case $k in (Gist|Source|"Raised by") continue ;;
            (Links) for l in $(printf '%s' "$v" | tr ';' '\n' | sed 's/^ *//; s/ /_/g'); do fm_list_add "$path" links "$(printf '%s' "$l" | tr '_' ' ')"; done; printf 'Links: added %s; ' "$v" ;;
            (Rationale|Impact|Options|Trigger|Mitigation|"Next action"|Notes) old=$(body_section "$path" "$k"); [ "$old" = "$v" ] && continue; body_set "$path" "$k" "$v"; printf '%s: %s to %s; ' "$k" "${old:-blank}" "$v" ;;
            (*) old=$(fm "$path" "$(kebab "$k")"); [ "$old" = "$v" ] && continue; fm_set "$path" "$(kebab "$k")" "$v"; printf '%s: %s to %s; ' "$k" "${old:-blank}" "$v" ;;
          esac; done | sed 's/; $//')
        sec=Source; [ "$type" = OI ] && sec="Raised by"
        printf '%s' "$cites" | tr '\002' '\n' | grep . | while IFS= read -r c; do body_append "$path" "$sec" "- $c"; done
        fm_set "$path" updated "$TODAY"
        history_add "$path" "$TODAY | $tid item $item | ${changes:-no field changed} | $(printf '%s' "$cites" | tr '\002' '\n' | grep . | paste -sd ';' - | sed 's/;/; /g')"
        [ "$type" = OI ] && [ "$(fld "$fields" Status)" = Closed ] && printf '%s\t%s\t%s\n' "$episode" "$id" "$(resolve_items "$(fld "$fields" Resolution)")" >> "$RES/closures"
        logrow "$id" updated "$(item_dir "$type")/$id.md" "${changes:-no field changed}"
      fi ;;
    SYS|PRC)
      path=$(item_path "$eng" "$id")
      if [ "$target" = new ]; then
        vals; set_val ID "$id"; set_val TID "$tid"; set_val EPISODE "$episode"; set_val DATE "$TODAY"; set_val DOMAIN "$domain"
        printf '%s' "$fields" | tr '\001' '\n' | while IFS= read -r kv; do k=${kv%%=*}; v=${kv#*=}; [ "$k" = Gist ] && continue; [ "$k" = Systems ] && v=$(resolve_items "$v"); set_val "$(upper_snake "$k")" "$v"; done
        render "$INGESTER_DIR/templates/items/$type.md" "$path"; vals_done
        logrow "$id" created "$(item_dir "$type")/$id.md" "$(fld "$fields" Name)$(fld "$fields" Title)"
      else [ -f "$path" ] || die "item $item targets $id, which does not exist"; fm_set "$path" updated "$TODAY"; printf '\n%s, item %s: %s\n' "$tid" "$item" "$(fld "$fields" Gist)" >> "$path"; logrow "$id" noted "$(item_dir "$type")/$id.md" "element note from item $item"
      fi ;;
    SYS.fact|PRC.step)
      parent=$(resolve_items "$(fld "$fields" System)$(fld "$fields" Process)"); [ "$type" = PRC ] && parent=$(resolve_items "$(fld "$fields" Process)")
      [ "$type" = SYS ] && parent=$(resolve_items "$(fld "$fields" System)")
      [ "$target" = new ] || parent=${target%.*}
      ppath=$(item_path "$eng" "$parent"); [ -f "$ppath" ] || die "item $item names $parent, which does not exist"
      if [ "$target" = new ]; then
        pre=f; [ "$type" = PRC ] && pre=s
        n=$(claim_sections "$ppath" | grep "^$pre" | sed "s/^$pre//" | sort -n | tail -1); sec="$pre$(( ${n:-0} + 1 ))"
        vals; set_val SECTION "$sec"; set_val TITLE "$(fld "$fields" Title)"; set_val KIND "$(fld "$fields" Kind)"; set_val PERFORMED_BY "$(fld "$fields" 'Performed by')"
        set_val SYSTEM "$(resolve_items "$(fld "$fields" System)")"; [ "$type" = SYS ] && set_val SYSTEM ""
        set_val STATUS "$(fld "$fields" Status)"; set_val CONFIDENCE "$(fld "$fields" Confidence)"; set_val ASSERTED_BY "$(fld "$fields" 'Asserted by')"
        set_val EPISODE "$episode"; set_val TID "$tid"; set_val SESSION_DATE "$session_date"; set_list EVIDENCE "$(printf '%s' "$cites" | tr '\002' '\n')"
        render "$INGESTER_DIR/templates/items/claim.md" "$RES/claim"; vals_done
        # Drop the lines that do not apply to this kind (kind on steps, performed-by and system on facts).
        if [ "$type" = SYS ]; then grep -v -e '^- performed-by: *$' -e '^- system: *$' "$RES/claim" > "$RES/claim2"; else grep -v -e '^- kind: *$' "$RES/claim" > "$RES/claim2"; fi
        awk -v ins="$RES/claim2" '/^## Questions/ && !done { while ((getline l < ins) > 0) print l; print ""; done=1 } { print } END { if (!done) while ((getline l < ins) > 0) print l }' "$ppath" > "$ppath.tmp" && mv "$ppath.tmp" "$ppath"
        fm_set "$ppath" updated "$TODAY"; cid="$parent.$sec"; IDMAP="$IDMAP $item=$cid"; logrow "$cid" created "$(item_dir "$type")/$parent.md" "$(fld "$fields" Title)"
      else
        # A claim mutation: status and confidence set, the block's citations added to evidence, a history entry (F10).
        sec=${target##*.}; changes=""
        for k in Status Confidence; do v=$(fld "$fields" "$k"); [ -n "$v" ] || continue; old=$(claim_field "$ppath" "$sec" "$(kebab "$k")"); [ "$old" = "$v" ] && continue
          claim_set "$ppath" "$sec" "$(kebab "$k")" "$v"; changes="$changes$(kebab "$k"): ${old:-blank} to $v; "; done
        changes=$(printf '%s' "$changes" | sed 's/; $//')
        printf '%s' "$cites" | tr '\002' '\n' | grep . | while IFS= read -r c; do claim_list_add "$ppath" "$sec" evidence "$c"; done
        claim_list_add "$ppath" "$sec" history "$TODAY | $tid item $item | ${changes:-no field changed} | session $tid, $session_date"
        fm_set "$ppath" updated "$TODAY"; logrow "$target" updated "$(item_dir "$type")/$parent.md" "${changes:-no field changed}"
      fi ;;
    TOP)
      path=$(item_path "$eng" "$id")
      if [ "$target" = new ]; then vals; set_val ID "$id"; set_val TITLE "$(fld "$fields" Title)"; set_val EPISODE "$episode"; set_val POSITION "$(fld "$fields" Position)"; set_val DATE "$TODAY"; set_list OPEN_ITEMS ""; set_list CLOSED_BY ""
        render "$INGESTER_DIR/templates/items/TOP.md" "$path"; vals_done; logrow "$id" created "topics/$id.md" "$(fld "$fields" Title)"
      else [ -f "$path" ] || die "item $item targets $id, which does not exist"; fm_list_add "$path" episodes "$episode"; fm_set "$path" updated "$TODAY"
        [ -n "$(fld "$fields" Position)" ] && printf '\n%s: %s\n' "$tid" "$(fld "$fields" Position)" >> "$path"; logrow "$id" updated "topics/$id.md" "episode $episode"; fi
      printf '%s\t%s\n' "$episode" "$id" >> "$RES/topics" ;;
    STK.edit)
      path=$(item_path "$eng" "$target"); [ -f "$path" ] || die "item $item targets $target, which does not exist"
      for k in Role Segment Department Standing Decides Organisation; do v=$(fld "$fields" "$k"); [ -n "$v" ] && fm_set "$path" "$(kebab "$k")" "$v"; done
      for v in $(fld "$fields" Variants | tr ',' '\n' | sed 's/^ *//; s/ /_/g'); do fm_list_add "$path" variants "$(printf '%s' "$v" | tr '_' ' ')"; done
      fm_set "$path" updated "$TODAY"; [ -n "$cites" ] && printf '%s\n' "$(cite_lines "$cites")" >> "$path"
      logrow "$target" updated "stakeholders/$target.md" "$(fld "$fields" Title)" ;;
    Question) ;;
  esac
done < "$items"

# Topics: open items and closing records created in each episode.
if [ -f "$RES/topics" ]; then
  while IFS="$US" read -r item kind grade verdict target episode bulk fields cites; do
    case $kind in OI|REQ|DEC) ;; *) continue ;; esac; [ "$target" = new ] || continue
    id=""; for pair in $IDMAP; do [ "${pair%%=*}" = "$item" ] && id=${pair#*=}; done
    top=$(awk -F'\t' -v e="$episode" '$1 == e { print $2; exit }' "$RES/topics"); [ -n "$top" ] || continue
    key=closed-by; [ "$kind" = OI ] && key=open-items; fm_list_add "$(item_path "$eng" "$top")" "$key" "$id"
  done < "$items"
  # An open item closed in an episode: its Resolution id (when it is an id) joins the topic's closed-by.
  [ -f "$RES/closures" ] && while IFS="$TAB" read -r episode oid res; do
    top=$(awk -F'\t' -v e="$episode" '$1 == e { print $2; exit }' "$RES/topics"); [ -n "$top" ] || continue
    case $res in REQ-*|DEC-*|LIM-*|RSK-*|OI-*) fm_list_add "$(item_path "$eng" "$top")" closed-by "$res" ;; esac; done < "$RES/closures"
fi

# Transcript file, engagement.md.
tf=$(item_path "$eng" "$tid")
fm_set "$tf" session-date "$session_date"; fm_set "$tf" domain "$domain"; fm_set "$tf" title "$(header_field "$dossier" 'Inferred purpose')"
fm_set "$tf" session-sheet-approver "$sheet_appr"; fm_set "$tf" session-sheet-approved-on "$sheet_on"; fm_set "$tf" dossier-completed-by "$dos_appr"; fm_set "$tf" dossier-completed-on "$dos_on"
awk '/^## Attendees/ { on=1 } /^## New/ { on=0 } on && /^\| / && !/Speaker tag/ && !/^\|---/' "$sheet" | while IFS= read -r row; do
  s=$(cell "$row" 2); [ "$s" = new ] && s=$(stk_lookup "$eng" "$(cell "$row" 1)" || true); [ -n "$s" ] && fm_list_add "$tf" attendees "$s"; done
sed -i '' "s/^- Ingester version last used:.*/- Ingester version last used: $(ingester_version)/; s/^- Rules version last used:.*/- Rules version last used: $(rules_version)/; s/^- Domain: to be set at S0/- Domain: $domain/" "$d/engagement.md"
bump_version "$d/engagement.md"
awk -v dt="$TODAY" '!done && /^- Stakeholders written on:/ { print; print "- S3 written on: " dt; done=1; next } { print }' "$log" > "$log.tmp" && mv "$log.tmp" "$log"
"$INGESTER_DIR/bin/render-index" "$eng" > /dev/null
rm -rf "$RES"; rm -f "$items"

# Move the transcript last.
mkdir -p "$d/transcripts/processed"; mv "$vtt" "$d/transcripts/processed/"
[ "$(sha256 "$d/transcripts/processed/$(basename "$vtt")")" = "$(transcript_field "$eng" "$tid" sha256)" ] || die "SHA-256 mismatch after move"
ok=1
log_run "$eng" "$tid" S3 "written" "$sheet $dossier" "$FOLDERS transcripts/$tid.md engagement.md $log" > /dev/null
eng_log "$eng" "$tid S3 written: $(table_rows "$log" | grep -c "| created ") id(s) created, $(table_rows "$log" | grep -c "| updated ") updated; dossier signed by $dos_appr; transcript moved to processed/."
printf 'S3: wrote %s id(s); see %s\n' "$(table_rows "$log" | grep -c '| created \|| updated ')" "$log"
